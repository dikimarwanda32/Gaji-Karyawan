<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="25dp"
    android:orientation="vertical"
    android:background="#A5E8D1"
    tools:context=".MainActivityDiki">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GAJI KARYAWAN"
        android:gravity="center"
        android:textColor="#091C88"
        android:textSize="30dp"
        android:textStyle="bold"
        android:background="#35C1D3"
        android:layout_marginBottom="100dp"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="30dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="30dp">

            <ImageView
                android:id="@+id/imgKaryawan"
                android:layout_width="100dp"
                android:layout_height="90dp"
                android:src="@drawable/ic_baseline_emoji_emotions_24"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gaji Karyawan"
                android:textStyle="bold"
                android:textSize="20dp"
                android:textColor="#0C2BD8"/>


        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="50dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgPetunjuk"
                android:layout_width="100dp"
                android:layout_height="90dp"
                android:src="@drawable/ic_baseline_import_contacts_24" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:text="Petunjuk"
                android:textColor="#0C2BD8"
                android:textSize="20dp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="50dp"
        android:layout_marginTop="50dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="30dp">
            <ImageView
                android:id="@+id/imgTentang"
                android:layout_width="100dp"
                android:layout_height="90dp"
                android:src="@drawable/ic_baseline_front_hand_24"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tentang"
                android:textStyle="bold"
                android:textSize="20dp"
                android:textColor="#0C2BD8"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="30dp"
            android:orientation="vertical">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="90dp"
                android:src="@drawable/ic_baseline_logout_24" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:text="Exit"
                android:textColor="#0C2BD8"
                android:textSize="20dp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>


</LinearLayout>

